{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["./src/types"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "vendor/**",
    "dist/**"
  ]
}
