{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["./src/types"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "vendor/**",
    "dist/**"
  ]
}
